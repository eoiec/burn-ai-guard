.page { padding: 24rpx 24rpx 80rpx; background: #f4f7fa; min-height: 100vh; }
.card { background: #fff; border-radius: 28rpx; padding: 30rpx; margin-top: 20rpx; box-shadow: 0 8rpx 30rpx rgba(23,60,78,.06); }
.h2 { font-size: 34rpx; font-weight: 700; margin-bottom: 8rpx; }
.h2.ok { color: #16a34a; }
.sub { font-size: 24rpx; color: #8494a1; margin-bottom: 20rpx; }
.steps { display: flex; gap: 10rpx; }
.st { flex: 1; text-align: center; background: #fff; border: 1rpx solid #e3eaf0; border-radius: 14rpx; padding: 12rpx 0; font-size: 22rpx; color: #8494a1; }
.st.on { background: #e6f6f4; border-color: #0ea5a4; color: #0f766e; font-weight: 700; }
.drop { border: 3rpx dashed #b9d6d3; border-radius: 24rpx; padding: 60rpx 20rpx; text-align: center; background: #fbfefd; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.ic { font-size: 64rpx; }
.big { font-size: 30rpx; font-weight: 600; }
.hint { font-size: 22rpx; color: #8494a1; }
.doclink { display: block; text-align: center; margin-top: 24rpx; color: #2563eb; font-size: 26rpx; }
.wound { width: 100%; height: 480rpx; border-radius: 24rpx; margin-top: 20rpx; }
.f { font-size: 25rpx; color: #51606c; margin: 20rpx 0 8rpx; }
.sel { background: #fbfdfe; border: 1rpx solid #e3eaf0; border-radius: 16rpx; padding: 18rpx 22rpx; font-size: 27rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 8rpx; }
.chip { font-size: 24rpx; padding: 12rpx 24rpx; border-radius: 999rpx; border: 1rpx solid #e3eaf0; background: #fbfdfe; color: #51606c; }
.chip.red.on { background: #fdecec; border-color: #dc2626; color: #dc2626; font-weight: 700; }
.btn { margin-top: 30rpx; background: linear-gradient(135deg, #0f766e, #0ea5a4); color: #fff; border-radius: 22rpx; font-size: 30rpx; }
.btn.ghost { background: #fff; color: #51606c; border: 1rpx solid #e3eaf0; }
.center { text-align: center; padding: 50rpx 30rpx; }
.ring { width: 110rpx; height: 110rpx; margin: 0 auto 20rpx; border-radius: 50%; border: 8rpx solid #e6f6f4; border-top-color: #0ea5a4; animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.verdict { border-radius: 28rpx; padding: 34rpx; color: #fff; margin-top: 20rpx; }
.verdict .k { font-size: 24rpx; opacity: .9; }
.verdict .name { font-size: 44rpx; font-weight: 700; margin: 6rpx 0 16rpx; }
.verdict .row { display: flex; align-items: center; gap: 26rpx; }
.confbox { background: rgba(255,255,255,.16); border-radius: 20rpx; padding: 16rpx 24rpx; text-align: center; }
.confnum { font-size: 44rpx; font-weight: 800; }
.conftip { font-size: 20rpx; opacity: .9; }
.meta { font-size: 23rpx; line-height: 1.8; opacity: .95; }
.bars { margin-top: 22rpx; }
.bar .lab { display: flex; justify-content: space-between; font-size: 23rpx; margin-bottom: 6rpx; }
.bar .track { height: 14rpx; background: rgba(255,255,255,.25); border-radius: 99rpx; }
.bar .fill { height: 100%; border-radius: 99rpx; }
.banner { border-radius: 20rpx; padding: 20rpx 24rpx; font-size: 25rpx; margin-top: 20rpx; }
.banner.warn { background: #fef4e2; color: #92600a; }
.banner.ok { background: #e9f7ee; color: #176a34; }
.banner.info { background: #eaf1fe; color: #1e4fae; }
.reason { color: inherit; opacity: .85; font-size: 23rpx; }
.reviewing { color: #92600a; font-size: 25rpx; }
.advhead { border-radius: 20rpx; padding: 24rpx; color: #fff; margin-top: 12rpx; }
.advhead .lv { font-size: 36rpx; font-weight: 800; }
.advhead .eta { font-size: 23rpx; opacity: .95; }
.advtip { font-size: 26rpx; color: #51606c; margin: 16rpx 0; }
.act { font-size: 26rpx; color: #51606c; padding: 12rpx 0; border-bottom: 1rpx dashed #e3eaf0; }
.pillrow { display: flex; flex-wrap: wrap; gap: 10rpx; }
.pill { font-size: 22rpx; padding: 8rpx 18rpx; border-radius: 999rpx; background: #fef4e2; color: #92600a; }
.pill.red { background: #fdecec; color: #dc2626; }
